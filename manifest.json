{
  "schemaVersion": 1,
  "id": "ozdogar.razer-mouse",
  "name": "Razer Mouse for Omarchy",
  "version": "1.0.0",
  "author": "ozdogar",
  "license": "MIT",
  "description": "Battery level and DPI control for Razer mice (via the OpenRazer daemon).",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Razer Mouse",
    "description": "Razer mouse battery level in the bar, with a DPI selector in the panel.",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showPercentage": true,
      "lowBatteryPercent": 20,
      "refreshIntervalSec": 60
    },
    "schema": [
      {
        "key": "showPercentage",
        "type": "boolean",
        "label": "Show battery percentage in the bar",
        "defaultValue": true
      },
      {
        "key": "lowBatteryPercent",
        "type": "integer",
        "label": "Low battery warning (%)",
        "min": 5,
        "max": 50,
        "step": 5,
        "defaultValue": 20
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval while closed (seconds)",
        "min": 15,
        "max": 600,
        "step": 15,
        "defaultValue": 60
      }
    ]
  },
  "homepage": "https://github.com/ozdogar-ai/razer-mouse-for-omarchy"
}
